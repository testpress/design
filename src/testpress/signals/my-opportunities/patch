+{% from "../../../ui-system/components/drawer.html" import drawer %}
+{% from "../../../ui-system/components/button.html" import button %}
+{% from "../../../ui-system/components/select.html" import select %}
+{% from "../../../ui-system/components/date-picker.html" import date_picker %}
+
+{% call drawer(id="attention-filter", title="Filters", placement="right", size="filter", extra_classes="bg-gray-50 dark:bg-neutral-900") %}
