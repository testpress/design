+    
+    {# Owner #}
+    <div class="p-4 bg-white rounded-xl border border-gray-200 dark:bg-neutral-900 dark:border-neutral-700" x-data="{ ownerFilter: 'all' }">
+      <div class="mb-3">
+        <h5 class="font-medium text-sm text-gray-800 dark:text-neutral-200">Owner</h5>
+      </div>
+      <div class="space-y-2">
+        <label for="owner-all" class="flex items-center gap-x-2.5 text-sm text-gray-800 dark:text-neutral-200 cursor-pointer">
+          <input type="radio" id="owner-all" name="filter_owner" value="all" class="shrink-0 mt-0.5 border-gray-200 rounded-full text-emerald-600 focus:ring-emerald-500 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-800 dark:border-neutral-700 dark:checked:bg-emerald-500 dark:checked:border-emerald-500 dark:focus:ring-offset-gray-800" x-model="ownerFilter">
+          All
+        </label>
+        <label for="owner-me" class="flex items-center gap-x-2.5 text-sm text-gray-800 dark:text-neutral-200 cursor-pointer">
+          <input type="radio" id="owner-me" name="filter_owner" value="me" class="shrink-0 mt-0.5 border-gray-200 rounded-full text-emerald-600 focus:ring-emerald-500 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-800 dark:border-neutral-700 dark:checked:bg-emerald-500 dark:checked:border-emerald-500 dark:focus:ring-offset-gray-800" x-model="ownerFilter">
+          Me
+        </label>
+        <label for="owner-unassigned" class="flex items-center gap-x-2.5 text-sm text-gray-800 dark:text-neutral-200 cursor-pointer">
+          <input type="radio" id="owner-unassigned" name="filter_owner" value="unassigned" class="shrink-0 mt-0.5 border-gray-200 rounded-full text-emerald-600 focus:ring-emerald-500 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-800 dark:border-neutral-700 dark:checked:bg-emerald-500 dark:checked:border-emerald-500 dark:focus:ring-offset-gray-800" x-model="ownerFilter">
+          Unassigned
+        </label>
+        <label for="owner-staff" class="flex items-center gap-x-2.5 text-sm text-gray-800 dark:text-neutral-200 cursor-pointer">
+          <input type="radio" id="owner-staff" name="filter_owner" value="staff" class="shrink-0 mt-0.5 border-gray-200 rounded-full text-emerald-600 focus:ring-emerald-500 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-800 dark:border-neutral-700 dark:checked:bg-emerald-500 dark:checked:border-emerald-500 dark:focus:ring-offset-gray-800" x-model="ownerFilter">
+          Staff members...
+        </label>
+      </div>
+
+      <div x-show="ownerFilter === 'staff'" x-collapse x-cloak class="mt-3">
+        {% set staff_options = [
+          { value: "arun_kumar", label: "Dr. Arun Kumar" },
+          { value: "priya_sharma", label: "Priya Sharma" },
+          { value: "anil_desai", label: "Anil Desai" }
+        ] %}
+        {{ select(
+          label="",
+          name="filter_staff",
+          placeholder="Search staff...",
+          options=staff_options,
+          search=true,
+          multiple=true
+        ) }}
+      </div>
+    </div>
+
+    {# Product #}
+    <div class="p-4 bg-white rounded-xl border border-gray-200 dark:bg-neutral-900 dark:border-neutral-700">
+      <div class="mb-3">
+        <h5 class="font-medium text-sm text-gray-800 dark:text-neutral-200">Product</h5>
+      </div>
+      {% set product_options = [
+        { value: "jee_advanced", label: "JEE Advanced Physics" },
+        { value: "neet_crash", label: "NEET Crash Course" },
+        { value: "upsc_prelims", label: "UPSC Prelims Series" }
+      ] %}
+      {{ select(
+        label="",
+        name="filter_product",
+        placeholder="Select products...",
+        options=product_options,
+        search=true,
+        multiple=true
+      ) }}
+    </div>
+
+
+
+    {# Urgency #}
+    <div class="p-4 bg-white rounded-xl border border-gray-200 dark:bg-neutral-900 dark:border-neutral-700">
+      <div class="mb-3">
+        <h5 class="font-medium text-sm text-gray-800 dark:text-neutral-200">Urgency</h5>
+      </div>
+      <div class="space-y-2">
+        {% for urgency in ["High", "Medium", "Low"] %}
+        <label class="flex items-center gap-x-2.5 text-sm text-gray-800 dark:text-neutral-200 cursor-pointer">
+          <input type="checkbox" class="shrink-0 mt-0.5 border-gray-200 rounded text-emerald-600 focus:ring-emerald-500 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-800 dark:border-neutral-700 dark:checked:bg-emerald-500 dark:checked:border-emerald-500 dark:focus:ring-offset-gray-800">
+          {{ urgency }}
+        </label>
+        {% endfor %}
+      </div>
+    </div>
+
+    {# Attention reason #}
+    <div class="p-4 bg-white rounded-xl border border-gray-200 dark:bg-neutral-900 dark:border-neutral-700">
+      <div class="mb-3">
+        <h5 class="font-medium text-sm text-gray-800 dark:text-neutral-200">Attention reason</h5>
+      </div>
+      <div class="space-y-2">
+        {% for reason in ["Payment failed", "Checkout started", "Viewed 7 times in 2 days", "Asked about course", "Viewed pricing 3 times", "Checkout abandoned", "Product enquiry"] %}
+        <label class="flex items-center gap-x-2.5 text-sm text-gray-800 dark:text-neutral-200 cursor-pointer">
+          <input type="checkbox" class="shrink-0 mt-0.5 border-gray-200 rounded text-emerald-600 focus:ring-emerald-500 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-800 dark:border-neutral-700 dark:checked:bg-emerald-500 dark:checked:border-emerald-500 dark:focus:ring-offset-gray-800">
+          {{ reason }}
+        </label>
+        {% endfor %}
+      </div>
+    </div>
+
+    {# Activity #}
+    <div class="p-4 bg-white rounded-xl border border-gray-200 dark:bg-neutral-900 dark:border-neutral-700" x-data="{ activityFilter: null }">
+      <div class="mb-3">
+        <h5 class="font-medium text-sm text-gray-800 dark:text-neutral-200">Activity</h5>
+      </div>
+      <div class="space-y-2">
+        {% for activity in ["Today", "Yesterday", "Last 7 days", "Last 30 days"] %}
+        <label for="activity-{{ loop.index }}" class="flex items-center gap-x-2.5 text-sm text-gray-800 dark:text-neutral-200 cursor-pointer">
+          <input type="radio" id="activity-{{ loop.index }}" name="filter_activity" value="{{ activity }}" class="shrink-0 mt-0.5 border-gray-200 rounded-full text-emerald-600 focus:ring-emerald-500 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-800 dark:border-neutral-700 dark:checked:bg-emerald-500 dark:checked:border-emerald-500 dark:focus:ring-offset-gray-800" x-model="activityFilter">
+          {{ activity }}
+        </label>
+        {% endfor %}
+        <label for="activity-custom" class="flex items-center gap-x-2.5 text-sm text-gray-800 dark:text-neutral-200 cursor-pointer">
+          <input type="radio" id="activity-custom" name="filter_activity" value="custom" class="shrink-0 mt-0.5 border-gray-200 rounded-full text-emerald-600 focus:ring-emerald-500 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-800 dark:border-neutral-700 dark:checked:bg-emerald-500 dark:checked:border-emerald-500 dark:focus:ring-offset-gray-800" x-model="activityFilter">
+          Custom range
+        </label>
+      </div>
+
+      <div x-show="activityFilter === 'custom'" x-collapse x-cloak class="mt-3">
+        {{ date_picker(
+          name="filter_date_range",
+          placeholder="Select Date Range",
+          range=true,
+          show_clear=true
+        ) }}
+      </div>
+    </div>
+  </div>
+  
+  <div class="p-4 border-t dark:border-neutral-700 bg-white dark:bg-neutral-800">
+    <div class="flex gap-x-2">
+      <button type="button" @click="$dispatch('close-drawer-attention-filter')" class="flex-1 py-2 px-3 inline-flex justify-center items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50 dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-300">
+        Clear All
+      </button>
+      <button type="button" @click="$dispatch('close-drawer-attention-filter')" class="flex-1 py-2 px-3 inline-flex justify-center items-center gap-x-2 text-sm font-medium rounded-lg border border-transparent bg-primary-600 text-white hover:bg-primary-700">
+        Apply Filters
+      </button>
+    </div>
+  </div>
+{% endcall %}
diff --git a/src/testpress/attention_inbox/includes/quick_chop.html b/src/testpress/attention_inbox/includes/quick_chop.html
new file mode 100644
index 00000000000..13eaea564b8
--- /dev/null
+++ b/src/testpress/attention_inbox/includes/quick_chop.html
@@ -0,0 +1,29 @@
+<!-- Quick Filter Tags Group -->
+<div class="flex flex-wrap gap-2" x-data="{
+  filters: [
+    { name: 'Needs attention', count: 24 },
+    { name: 'High urgency', count: 6 },
+    { name: 'Unassigned', count: 8 },
+    { name: 'Waiting on student', count: 12 },
+    { name: 'Follow-up scheduled', count: 5 }
+  ],
+  activeFilter: 'Needs attention'
+}">
+  <template x-for="filter in filters" :key="filter.name">
+    <button type="button" 
+      @click="activeFilter = filter.name"
+      class="py-1.5 px-3 inline-flex items-center gap-x-1.5 text-xs rounded-md border cursor-pointer transition-colors"
+      :class="activeFilter === filter.name 
+        ? 'font-medium bg-emerald-100 dark:bg-emerald-900 border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300' 
+        : 'bg-white dark:bg-neutral-800 border-gray-200 dark:border-neutral-700 text-gray-700 dark:text-neutral-300 hover:bg-gray-50 dark:hover:bg-neutral-700'"
+    >
+      <span x-text="filter.name"></span>
+      <span class="ml-1" 
+        :class="activeFilter === filter.name 
+          ? 'text-emerald-600 dark:text-emerald-400 font-normal' 
+          : 'text-gray-500 dark:text-neutral-400'" 
+        x-text="filter.count"></span>
+    </button>
+  </template>
+</div>
+<!-- End Quick Filter Tags Group -->
